rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // sensor collection: clients may read when authenticated.
    // Clients MUST NOT be allowed to write here.
    // The ingestion bridge (VM) should write using the Admin SDK with a
    // service account. Admin SDK calls bypass security rules, so the VM can
    // continue writing even though client writes are denied.
    match /sensor/{docId} {
      allow read: if request.auth != null;
      // Prevent client-side writes. Use Admin SDK on the server/VM instead.
      allow write: if false;
    }

    // Optional: a users collection where each user can manage their own doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default (no wildcard permissive rules).
  }
}
